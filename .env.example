# ── Público (llega al navegador) ─────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Poner en true recién al lanzar: habilita la indexación en buscadores.
NEXT_PUBLIC_LAUNCHED=false

# ── Secreto (sólo servidor; NUNCA con prefijo NEXT_PUBLIC_) ───────────
# Supabase → Project Settings → API → service_role. Sólo cron, webhooks y consola interna.
SUPABASE_SERVICE_ROLE_KEY=
# Fase 3 · Emails transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM="Cobra+ <avisos@primerosprecios.com>"
# Fase 3 · Protege /api/cron/* (generar con: openssl rand -hex 32)
CRON_SECRET=

# Firma de los links de baja de los emails (generar uno largo y aleatorio)
UNSUBSCRIBE_SECRET=

# Mercado Pago · Suscripciones de Cobra+ (aplicación "cobra-plus" en la cuenta de PrimerosPrecios)
# En pruebas: Access Token de PRODUCCIÓN de la cuenta de prueba VENDEDORA (APP_USR-...).
MP_ACCESS_TOKEN_COBRA=
# Clave secreta de Webhooks de la aplicación (Mercado Pago > cobra-plus > Webhooks).
MP_WEBHOOK_SECRET_COBRA=
# Sólo en pruebas: email de la cuenta de prueba COMPRADORA (Mercado Pago exige que pague una cuenta de prueba).
MP_TEST_PAYER_EMAIL=
# Base https para volver de Mercado Pago (Mercado Pago no acepta http://localhost). Opcional.
MP_BACK_URL_BASE=
