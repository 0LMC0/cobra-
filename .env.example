# ── Público (llega al navegador) ─────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Poner en true recién al lanzar: habilita la indexación en buscadores.
NEXT_PUBLIC_LAUNCHED=false

# ── Secreto (sólo servidor; NUNCA con prefijo NEXT_PUBLIC_) ───────────
# Supabase → Project Settings → API → service_role. Sólo cron, webhooks y consola interna.
SUPABASE_SERVICE_ROLE_KEY=
# Fase 3 · Emails transaccionales (Resend)
RESEND_API_KEY=
EMAIL_FROM="COBRA <avisos@tu-dominio.com>"
# Fase 3 · Protege /api/cron/* (generar con: openssl rand -hex 32)
CRON_SECRET=
